# loam compose configuration (loam-lzxo.2).
#
#   cp deploy/.env.example deploy/.env
#   # edit deploy/.env, then:
#   docker compose -f deploy/docker-compose.yml up -d
#
# Compose picks this up automatically: the project directory is the
# directory holding the compose file, so `deploy/.env` is read with no
# --env-file flag, from wherever you run the command.
#
# `deploy/.env` is gitignored. This example file is not; never put a real
# secret in it.
#
# WHY THERE ARE NO WORKING PLACEHOLDERS FOR THE THREE SECRETS BELOW, since
# it is a deliberate trade and the friction is the point. The alternative
# -- shipping LOAM_ADMIN_PASSWORD=changeme so `up -d` works out of the box
# -- produces a stack that BOOTS SUCCESSFULLY with a password every reader
# of this repository knows, on a service with no agent authentication at
# all. Nothing later forces a change, and nothing surfaces that it was
# never changed: it looks identical to a correctly configured deployment.
# The encryption key is worse: a shared literal key would make every
# deployment that skipped this file mutually decryptable. So the compose
# file uses `${VAR:?...}` for all three, and refuses to render without
# them. The cost is one legible error message on the first run; the
# benefit is that "I forgot to change it" is not reachable.
#
# Every other variable is defaulted in deploy/docker-compose.yml to match
# helm/loam/values.yaml, and is listed here only so you know it exists.

# ======================================================================
# MUST SET
# ======================================================================

# ----------------------------------------------------------------------
# LOAM_ENCRYPTION_KEY -- base64 of 32 random bytes. Generate with:
#
#     openssl rand -base64 32
#
# (works as-is on macOS and on Linux; no coreutils/BSD difference to
# navigate, unlike `head -c 32 /dev/urandom | base64`, which wraps
# differently across platforms.)
#
#   ####################################################################
#   #  THIS KEY CANNOT BE ROTATED IN PLACE, AND LOSING IT IS NOT A     #
#   #  RECOVERABLE MISTAKE.                                            #
#   #                                                                  #
#   #  It encrypts every stored forge credential (AES-GCM over         #
#   #  credentials.token_ciphertext). On every boot the server tries   #
#   #  to decrypt each stored credential with this key BEFORE it binds #
#   #  its HTTP listener. A key that does not match refuses to start   #
#   #  -- not a degraded mode, not a warning: the container            #
#   #  crashloops and /healthz never comes up.                         #
#   #                                                                  #
#   #  A DATABASE BACKUP DOES NOT COVER THIS KEY. The key is nowhere   #
#   #  in Postgres. pg_dump carries the ciphertext and not the thing   #
#   #  that opens it. Back this value up SEPARATELY -- a password      #
#   #  manager, wherever you keep your other unrecoverable secrets --  #
#   #  and note where you put it. Backing up the database and not this #
#   #  file leaves you with a restore that cannot start.               #
#   #                                                                  #
#   #  DO NOT regenerate this key to "reset" anything. There is no     #
#   #  reset. Recovery from a lost key means deleting every            #
#   #  credentials row by hand in SQL and re-entering every forge      #
#   #  token -- docs/deployment-spec.md -> "The coupling:              #
#   #  LOAM_ENCRYPTION_KEY" has the exact procedure.                   #
#   ####################################################################
# ----------------------------------------------------------------------
LOAM_ENCRYPTION_KEY=

# Admin console password (HTTP basic auth, with LOAM_ADMIN_USER below).
# Generate one rather than inventing one: `openssl rand -base64 24`.
# Unlike the encryption key, this one IS freely changeable: edit it here
# and `up -d` again. Nothing stored depends on it.
LOAM_ADMIN_PASSWORD=

# Postgres password for the bundled database. Read by BOTH the postgres
# service (POSTGRES_PASSWORD) and loam (LOAM_DB_PASSWORD) from this one
# variable, so they cannot drift apart.
#   `openssl rand -base64 24`
# CONSUMED ONCE. The postgres image only initialises a data directory it
# finds empty, so changing this after the first `up` changes what loam
# sends and NOT what the database expects -- the result is loam failing
# readiness with an authentication error. To actually change it, use ALTER
# ROLE inside the container and then update this file, or start over with
# `down -v` (which destroys all data).
LOAM_DB_PASSWORD=

# Where loam finds its embedder. No default is correct, so there is none:
# internal/config's own default (http://localhost:11434) means "inside the
# loam container" here and is never right. Pick one:
#
#   1. ollama you already run on THIS HOST.
#      Docker Desktop (macOS, Windows) and recent Docker Engine:
#          LOAM_EMBEDDER_URL=http://host.docker.internal:11434
#      Plain Linux with Docker Engine, where host.docker.internal does not
#      resolve by default, either add to the loam service:
#          extra_hosts:
#            - "host.docker.internal:host-gateway"
#      or use the docker0 bridge address directly, usually:
#          LOAM_EMBEDDER_URL=http://172.17.0.1:11434
#      (confirm with `ip -4 addr show docker0`). Either way ollama must be
#      listening on more than loopback for the container to reach it:
#          OLLAMA_HOST=0.0.0.0:11434 ollama serve
#      Podman users: `host.containers.internal` also works.
#
#   2. ollama on ANOTHER machine: its URL, e.g. http://10.0.0.5:11434
#
#   3. The BUNDLED ollama, opt-in:
#          LOAM_EMBEDDER_URL=http://ollama:11434
#      and bring the stack up with `--profile ollama`. Costs roughly 5 GB
#      of disk and ~1 GB of RAM, CPU-only -- see the ollama services in
#      deploy/docker-compose.yml.
#
# Whichever you choose, the model named by LOAM_EMBEDDER_MODEL must
# already be pulled there. The bundled profile does that for you; options
# 1 and 2 are yours to arrange (`ollama pull nomic-embed-text`).
LOAM_EMBEDDER_URL=

# ======================================================================
# OPTIONAL -- every one of these is already defaulted in
# deploy/docker-compose.yml to the value helm/loam/values.yaml uses.
# Uncomment only to change one.
# ======================================================================

# Host interface and port the admin console / RPC surface is published on.
# LOOPBACK BY DEFAULT, deliberately: loam's MVP has no agent
# authentication -- identity and role are trusted exactly as asserted in
# the client's LOAM_AGENT_* environment (README -> Agent Identity &
# Roles). Anyone who can reach this port can act as any agent in any role.
# Set 0.0.0.0 only behind something that authenticates, or on a network
# where you trust every host.
#LOAM_HTTP_BIND=127.0.0.1
#LOAM_HTTP_PORT=8080

# Admin console username.
#LOAM_ADMIN_USER=admin

# Postgres user and database name for the bundled database. Like the
# password, these are consumed only on first initialisation.
#LOAM_DB_USER=loam
#LOAM_DB_NAME=loam

# Embedding model. NOT a free configuration knob: loam-c94.16 fixed an
# ingest failure where a fixed bytes-per-token ratio could not bound
# nomic-embed-text's 2048-token context, and that bound is specific to
# this model. A different model needs that arithmetic revisited, and every
# vector already in the database was produced by the old one -- changing
# this on a populated instance mixes embedding spaces.
#LOAM_EMBEDDER_MODEL=nomic-embed-text

# Concurrent ingest workers (1-256).
#LOAM_INGEST_WORKERS=2

# debug | info | warn | error
#LOAM_LOG_LEVEL=info

# Attribute upstream PRs to the agent that authored the work branch.
#LOAM_PR_ATTRIBUTION=true

# How often each enrolled repo is fetched from upstream. Must be positive.
#LOAM_SYNC_INTERVAL=60s

# Server image. Pinned in deploy/docker-compose.yml to an immutable
# commit-sha tag; override to run a different published build, or a local
# one from `task docker:build` (registry.bobcob7.com/loam/server:dev).
#LOAM_IMAGE=registry.bobcob7.com/loam/server:bdea9ab7c5b07f5f9086b81f61ed4a7536024af2

# Ollama image used by the opt-in `ollama` profile.
#LOAM_OLLAMA_IMAGE=ollama/ollama:0.13.2
